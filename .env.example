# Application
APP_ENV=development
APP_HOST=0.0.0.0
IMPORT_API_PORT=8000
QUERY_API_PORT=8001
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
INFRA_HEALTH_TIMEOUT_SECONDS=3

# MinIO (replace example credentials in a real .env file)
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=shopkeeper
MINIO_SECRET_KEY=shopkeeper-minio-change-me
MINIO_BUCKET_NAME=shopkeeper-knowledge

# Milvus
MILVUS_URL=http://localhost:19530
MILVUS_GRPC_PORT=19530
MILVUS_WEB_PORT=9091
ATTU_PORT=7000
CHUNKS_COLLECTION=knowledge_chunks
ITEM_NAME_COLLECTION=knowledge_item_names
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.35

# MongoDB
MONGO_PORT=27017
MONGO_ROOT_USERNAME=shopkeeper
MONGO_ROOT_PASSWORD=shopkeeper-mongo-change-me
MONGO_URL=mongodb://shopkeeper:shopkeeper-mongo-change-me@localhost:27017/?authSource=admin
MONGO_DB_NAME=shopkeeper_brain

# OpenAI-compatible text and vision models
OPENAI_API_BASE=
DASHSCOPE_API_KEY=
LLM_DEFAULT_MODEL=
LLM_DEFAULT_TEMPERATURE=0
VL_MODEL=
ITEM_MODEL=

# Local embedding and reranking models
BGE_M3_PATH=BAAI/bge-m3
BGE_RERANKER_LARGE=BAAI/bge-reranker-large
BGE_DEVICE=cpu
BGE_FP16=false
EMBEDDING_DIM=1024

# MinerU
MINERU_MODEL_SOURCE=modelscope
MINERU_API_TOKEN=
MINERU_BASE_URL=
MODELSCOPE_OFFLINE=0
MODELSCOPE_CACHE=
HF_HOME=

# Optional external/MCP retrieval
WEB_SEARCH_ENABLED=false
MCP_DASHSCOPE_BASE_URL=
